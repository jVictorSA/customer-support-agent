APP_ENV=development

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=customer_support_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_VOLUME_NAME=customer_support_agent_postgres_data

API_PORT=8000

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_HEALTHCHECK_TIMEOUT=3

DB_STARTUP_CHECK_ENABLED=true
DB_STARTUP_MAX_RETRIES=10
DB_STARTUP_RETRY_DELAY=1.0

# Optional override for managed databases:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Document ingestion ---------------------------------------------------
DOCUMENTS_MAX_UPLOAD_MB=50
DOCUMENTS_MAX_PAGES=500
DOCUMENTS_STORAGE_BUCKET=rag-documents
DOCUMENTS_OCR_ENABLED=false
DOCUMENTS_OCR_LANGUAGES=por+eng
DOCUMENTS_CHUNK_TARGET_TOKENS=800
DOCUMENTS_CHUNK_MAX_TOKENS=1000
DOCUMENTS_CHUNK_MIN_TOKENS=150
DOCUMENTS_CHUNK_OVERLAP_TOKENS=60

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001

RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Optional full override:
# CELERY_BROKER_URL=amqp://user:password@host:5672//

CELERY_MAX_RETRIES=3
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800

JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIMENSIONS=1024
JINA_TIMEOUT=60
JINA_BATCH_SIZE=16
JINA_BATCH_MAX_TOKENS=16000
JINA_MAX_RETRIES=10
JINA_RPM=100
JINA_TPM=100000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=5
DEEPSEEK_SUMMARY_MAX_TOKENS=800
DEEPSEEK_SUMMARY_INPUT_MAX_TOKENS=6000

DEEPSEEK_DISABLE_THINKING=true

# Authentication -------------------------------------------------------
AUTH_JWT_SECRET=dev-only-change-me-please-use-32-bytes
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Conversational agent -------------------------------------------------
AGENT_MAX_ITERATIONS=6
AGENT_HISTORY_MAX_MESSAGES=20
AGENT_HISTORY_MAX_TOKENS=6000
AGENT_PROMPT_VERSION=conversation-v1
AGENT_TEXT_TO_SQL_ENABLED=false
AGENT_DISABLE_THINKING=true
AGENT_INTENT_MODEL=
AGENT_ORCHESTRATOR_MODEL=
AGENT_REWRITER_MODEL=
AGENT_WRITER_MODEL=
AGENT_INTENT_TEMPERATURE=0
AGENT_ORCHESTRATOR_TEMPERATURE=0.1
AGENT_REWRITER_TEMPERATURE=0
AGENT_WRITER_TEMPERATURE=0.4
AGENT_INTENT_MAX_TOKENS=600
AGENT_ORCHESTRATOR_MAX_TOKENS=1200
AGENT_REWRITER_MAX_TOKENS=400
AGENT_WRITER_MAX_TOKENS=1200
AGENT_TOOL_RESULT_MAX_CHARS=6000

# Text-to-SQL ----------------------------------------------------------
AGENT_TEXT_TO_SQL_ENABLED=false
# Role fixo da migration de RLS; altere apenas com grants manuais.
TEXT_TO_SQL_DB_USER=text_to_sql_reader
TEXT_TO_SQL_DB_PASSWORD=dev-only-text-to-sql-password
# Optional full override for managed databases:
# TEXT_TO_SQL_DATABASE_URL=postgresql+asyncpg://text_to_sql_reader:password@host:5432/database
TEXT_TO_SQL_MODEL=
TEXT_TO_SQL_TEMPERATURE=0
TEXT_TO_SQL_MAX_TOKENS=900
TEXT_TO_SQL_MAX_ATTEMPTS=2
TEXT_TO_SQL_MAX_ROWS=50
TEXT_TO_SQL_WRITER_ROWS=20
TEXT_TO_SQL_STATEMENT_TIMEOUT_MS=5000
TEXT_TO_SQL_MAX_JOINS=4
TEXT_TO_SQL_MAX_AST_DEPTH=30
TEXT_TO_SQL_MAX_CTES=3
TEXT_TO_SQL_MAX_UNION_BRANCHES=2
TEXT_TO_SQL_MAX_RESULT_CHARS=6000

RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_LEXICAL_TOP_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_FINAL_K=8
RETRIEVAL_CONTEXT_MAX_TOKENS=6000

CONVERSATION_WEBHOOK_SECRET=dev-only-webhook-secret-use-32-bytes
CONVERSATION_WEBHOOK_TIMEOUT=10
CONVERSATION_WEBHOOK_MAX_RETRIES=5
# Development only: allows http://api:8000 and localhost webhook receivers.
CONVERSATION_WEBHOOK_ALLOW_PRIVATE_HOSTS=true

CELERY_AGENT_TASK_SOFT_TIME_LIMIT=240
CELERY_AGENT_TASK_TIME_LIMIT=300
CELERY_AGENT_MAX_RETRIES=3
